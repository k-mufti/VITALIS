# Copy to .env and fill in. Never commit .env.

# No NASA key needed: DONKI moved to the keyless CCMC DONKI-API on 2026-09-30.

# AI medical officer. Set ONE of these. With neither, the officer uses a built-in rule-based answer.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Mission setup. Day 0 = launch. Default makes today (Nov 14 2026) mission day 184.
MISSION=mars
MISSION_LAUNCH_DATE=2026-05-14
MISSION_DAY=184

# Speeds up the Earth comms delay for the demo. 60 = a 12 minute delay plays out in 12 seconds.
TRIAGE_TIME_SCALE=60

# Vitaly voice assistant (OpenRouter). The key stays on the backend; the browser never sees it.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=mistralai/mistral-nemo
OPENROUTER_FALLBACK_MODEL=meta-llama/llama-3.1-8b-instruct

# Vitaly's voice (Deepgram Aura text-to-speech). Without a key, Chrome's built-in voice is used.
DEEPGRAM_API_KEY=
DEEPGRAM_TTS_MODEL=aura-2-draco-en
