# Copy to .env and fill in. Never commit .env.

# No NASA key needed: DONKI moved to the keyless CCMC DONKI-API on 2026-09-30.

# AI medical officer. Set ONE of these. With neither, the officer uses a built-in rule-based answer.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Mission setup. Day 0 = launch. Default makes today (Nov 14 2026) mission day 184.
MISSION=mars
MISSION_LAUNCH_DATE=2026-05-14
MISSION_DAY=184

# Speeds up the Earth comms delay for the demo. 60 = a 12 minute delay plays out in 12 seconds.
TRIAGE_TIME_SCALE=60

# Vitaly voice assistant (OpenRouter). The key stays on the backend; the browser never sees it.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=mistralai/mistral-nemo
OPENROUTER_FALLBACK_MODEL=meta-llama/llama-3.1-8b-instruct

# Vitaly's voice (Deepgram Aura text-to-speech). Without a key, Chrome's built-in voice is used.
DEEPGRAM_API_KEY=
DEEPGRAM_TTS_MODEL=flux-colin-en
# 1.0 is normal speed. Expressivity (Flux only, beta): -2 to 2, 0 is the default.
DEEPGRAM_TTS_SPEED=1.0
DEEPGRAM_TTS_EXPRESSIVITY=0
# Vitaly's ears use the same key (Deepgram live speech-to-text). Without a key, Chrome's recognition is used.
DEEPGRAM_STT_MODEL=nova-3

# Real watch data: a Fitbit through the Google Health API (Fitbit's own API was switched off in Nov 2026).
# Create an OAuth client of type "Web" in Google Cloud Console, enable the Google Health API, add yourself as a
# test user, and register this redirect URI exactly. In Google's Testing mode the connection lasts 7 days.
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
GOOGLE_HEALTH_REDIRECT_URI=http://localhost:8001/api/fitbit/callback
FITBIT_DEVICE_NAME=Fitbit Versa 4
