# The VITALIS backend. Copy to /etc/systemd/system/vitalis.service, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now vitalis
# One worker on purpose: the simulated crew member lives in memory.
[Unit]
Description=VITALIS backend
After=network.target

[Service]
User=www-data
WorkingDirectory=/opt/vitalis/backend
ExecStart=/opt/vitalis/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8001 --workers 1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
